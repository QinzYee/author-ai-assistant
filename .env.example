# ===== 服务 =====
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# ===== 数据库 =====
# data/ 目录（已 gitignore），每项目一个 .db
DATA_DIR=./data

# ===== LLM：正文生成 / 提取（DeepSeek，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 提取/校验/摘要类 pass 用的便宜模型（默认同上）
EXTRACT_MODEL=deepseek-chat

# ===== LLM：MiniMax（可选，正文/提取用，OpenAI 兼容 /chat/completions）=====
# 聊天 provider 选哪家：deepseek（默认）| minimax | openai | ollama | mock
CHAT_PROVIDER=deepseek
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01
# OpenAI 直连（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama 本地聊天模型（可选）
OLLAMA_CHAT_MODEL=qwen2.5

# ===== LLM：Embedding（硅基流动 BGE-M3，OpenAI 兼容 /embeddings）=====
# 注意：DeepSeek 官方无 embedding 接口，见架构文档 §11.1/§14
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ===== LLM：本地 Ollama（可选）=====
OLLAMA_BASE_URL=http://localhost:11434

# ===== 开发模式 =====
# GATEWAY_MODE=mock 时用确定性假数据跑通全链路（不需要 API Key）
GATEWAY_MODE=

# ===== 热点调研（可选）=====
TAVILY_API_KEY=
