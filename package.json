{
  "name": "author-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI 小说创作工具 —— 本地 Web 应用，主打长篇一致性（人物/设定/伏笔不崩）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsc -p tsconfig.server.json && node dist/server/server/index.js",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "cross-env NODE_ENV=production node dist/server/server/index.js",
    "db:migrate": "tsc -p tsconfig.server.json && node dist/server/server/db/migrate.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
